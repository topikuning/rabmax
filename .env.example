# === Database ===
DATABASE_URL=postgresql+psycopg://boq_user:boq_pass@localhost:5432/boq

# === App ===
APP_ENV=development
STORAGE_PATH=./storage
LOG_LEVEL=INFO

# === Auth (multi-user) ===
# WAJIB di-set acak di production (mis. `openssl rand -hex 32`).
SECRET_KEY=CHANGE_ME_dev_only_secret_do_not_use_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOW_OPEN_REGISTRATION=true

# === AI providers (minimal 1 wajib diisi) ===
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
DEFAULT_AI_PROVIDER=claude

# === CORS ===
# Origin eksak yang diizinkan (JSON array). Tambah domain custom di sini.
CORS_ORIGINS=["http://localhost:3000"]
# Regex origin tambahan. Default sudah cover localhost/127.0.0.1 + *.up.railway.app,
# jadi deploy Railway tidak perlu set ini. Untuk domain custom, sesuaikan.
# CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?domainku\.com$
