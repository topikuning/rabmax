# === Database ===
DATABASE_URL=postgresql+psycopg://boq_user:boq_pass@localhost:5432/boq

# === App ===
APP_ENV=development
STORAGE_PATH=./storage
LOG_LEVEL=INFO

# === Seeding ===
# Saat startup, isi DB dari data AHSP bawaan (SE DJBK 47/2026) bila tabel kosong.
AUTO_SEED=true

# === Auth (multi-user) ===
# WAJIB di-set acak di production (mis. `openssl rand -hex 32`).
SECRET_KEY=CHANGE_ME_dev_only_secret_do_not_use_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOW_OPEN_REGISTRATION=true

# === AI providers (minimal 1 wajib diisi) ===
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
DEFAULT_AI_PROVIDER=claude

# === CORS ===
# Daftar domain frontend, dipisah koma. Atau "*" untuk semua (aman: auth pakai
# Bearer token, bukan cookie). Contoh:
#   CORS_ORIGINS=https://rabmax.cvbintang.com,https://domain-lain.com
CORS_ORIGINS=*
